# Application
DOYBIZ_ENV=dev
PORT=3000
MONGODB_URI=mongodb://localhost:27017/doybiz
# Optional: explicit isolated database for destructive integration tests
# MONGODB_TEST_URI=mongodb://localhost:27017/doybiz_test
JWT_SECRET=replace-with-strong-secret

# Bootstrap Super Admin (platform-level; never store a plaintext password here)
SUPER_ADMIN_ENABLED=true
SUPER_ADMIN_EMAIL=admin@doybiz.com
SUPER_ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash

# Xendit
XENDIT_SECRET_KEY=replace-with-xendit-secret-key
XENDIT_WEBHOOK_TOKEN=replace-with-webhook-token
XENDIT_BASE_URL=https://api.xendit.co

# Cloudinary (server-side signed uploads; never expose API secret to the browser)
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
