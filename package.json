{
  "name": "doybiz-backend",
  "version": "1.0.0",
  "description": "Multi-tenant Business Management Platform Backend",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:smoke",
    "test:smoke": "ts-node src/testSmoke.ts",
    "test:integration": "npm run test:phase2 && npm run test:phase3 && npm run test:phase4 && npm run test:phase5 && npm run test:phase6 && npm run test:phase7",
    "test:phase2": "ts-node src/testPhase2.ts",
    "test:phase3": "ts-node src/testPhase3.ts",
    "test:phase4": "ts-node src/testPhase4.ts",
    "test:phase5": "ts-node src/testPhase5.ts",
    "test:phase6": "ts-node src/testPhase6.ts",
    "test:phase7": "ts-node src/testPhase7.ts"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "@types/multer": "^2.0.0"
  }
}
